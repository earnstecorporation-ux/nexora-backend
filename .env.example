# Port to run the server on (default: 3000)
PORT=3000

# Razorpay API Credentials (from Razorpay Dashboard -> Settings -> API Keys)
# Keep RAZORPAY_KEY_ID in Test Mode for development (starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Razorpay Key Secret (CONFIDENTIAL - NEVER EXPOSE IN CLIENT APP OR COMMIT TO GIT)
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
